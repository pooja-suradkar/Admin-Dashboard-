
import { useCallback, useEffect, useMemo, useState } from "react";
import {
  Bell, Search, RefreshCw, Users, ShoppingBag,
  IndianRupee, Package, ChevronLeft, ChevronRight,
} from "lucide-react";

import Sidebar from "./components/Sidebar";
import StatCard from "./components/StatCard";
import UserTable from "./components/UserTable";
import { getUsers, deleteUser } from "./services/userApi";
import "./App.css";

const PAGE_SIZE = 5;

export default function App() {
  const [users, setUsers] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [search, setSearch] = useState("");
  const [page, setPage] = useState(1);
  const [active, setActive] = useState("Dashboard");
  const [deleting, setDeleting] = useState(null);

  const fetchUsers = useCallback(async (signal) => {
    setLoading(true);
    setError("");

    try {
      const data = await getUsers(signal);

      if (!signal.aborted) {
        setUsers(data);
      }
    } catch (err) {
      if (err.name !== "AbortError" && !signal.aborted) {
        setError(err.message || "Something went wrong");
      }
    } finally {
      if (!signal.aborted) {
        setLoading(false);
      }
    }
  }, []);

  useEffect(() => {
    const controller = new AbortController();

    fetchUsers(controller.signal);

    return () => controller.abort();
  }, [fetchUsers]);

  const filteredUsers = useMemo(() => {
    const query = search.trim().toLowerCase();

    return users.filter((user) =>
      [user.name, user.email, user.address?.city]
        .some((value) => value?.toLowerCase().includes(query))
    );
  }, [users, search]);

  const totalPages = Math.ceil(filteredUsers.length / PAGE_SIZE);

  const currentPage = Math.min(page, Math.max(totalPages, 1));

  const visibleUsers = filteredUsers.slice(
    (currentPage - 1) * PAGE_SIZE,
    currentPage * PAGE_SIZE
  );

  const handleDelete = async (id) => {
    const confirmed = window.confirm(
      "Are you sure you want to delete this user?"
    );

    if (!confirmed) return;

    setDeleting(id);
    setError("");

    try {
      await deleteUser(id);

      // JSONPlaceholder simulates DELETE.
      // Update local UI because server data is not permanently deleted.
      setUsers((previous) =>
        previous.filter((user) => user.id !== id)
      );
    } catch (err) {
      setError(err.message || "Unable to delete user");
    } finally {
      setDeleting(null);
    }
  };

  const stats = [
    {
      title: "Total Users",
      value: users.length.toLocaleString(),
      change: "+12.5%",
      type: "users",
    },
    {
      title: "Total Revenue",
      value: "₹45,250",
      change: "+8.2%",
      type: "revenue",
    },
    {
      title: "Total Orders",
      value: "1,250",
      change: "+15.3%",
      type: "orders",
    },
    {
      title: "Products",
      value: "320",
      change: "+4.5%",
      type: "products",
    },
  ];

  return (
    <div className="app-layout">
      <Sidebar active={active} onNavigate={setActive} />

      <main className="main-content">
        <header className="topbar">
          <div>
            <p className="eyebrow">OVERVIEW</p>
            <h1>{active}</h1>
          </div>

          <div className="topbar-actions">
            <label className="global-search">
              <Search size={18} />
              <input
                placeholder="Search users..."
                value={search}
                onChange={(e) => {
                  setSearch(e.target.value);
                  setPage(1);
                }}
                aria-label="Search users"
              />
            </label>

            <button className="icon-btn" aria-label="Notifications">
              <Bell size={20} />
            </button>
          </div>
        </header>

        {active === "Dashboard" || active === "Users" ? (
          <>
            <section className="welcome-section">
              <div>
                <h2>Welcome back, Admin! 👋</h2>
                <p>Here is what's happening with your store today.</p>
              </div>

              <button
                className="refresh-btn"
                onClick={() => {
                  const controller = new AbortController();
                  fetchUsers(controller.signal);
                }}
                disabled={loading}
              >
                <RefreshCw size={16} />
                Refresh data
              </button>
            </section>

            <section className="stats-grid">
              {stats.map((stat) => (
                <StatCard key={stat.type} {...stat} />
              ))}
            </section>

            <section className="panel">
              <div className="panel-header">
                <div>
                  <h2>User Management</h2>
                  <p>Manage and monitor your registered users.</p>
                </div>

                <div className="total-count">
                  <Users size={17} />
                  {filteredUsers.length} users
                </div>
              </div>

              {error && (
                <div className="error-message" role="alert">
                  <p>{error}</p>
                  <button
                    onClick={() => {
                      const controller = new AbortController();
                      fetchUsers(controller.signal);
                    }}
                  >
                    Try again
                  </button>
                </div>
              )}

              {loading ? (
                <div className="loading-state">
                  <span className="spinner" />
                  <p>Loading users...</p>
                </div>
              ) : (
                <>
                  <UserTable
                    users={visibleUsers}
                    onDelete={handleDelete}
                    deleting={deleting}
                  />

                  <div className="pagination">
                    <span>
                      Showing {filteredUsers.length === 0 ? 0 :
                        (currentPage - 1) * PAGE_SIZE + 1}
                      {" - "}
                      {Math.min(currentPage * PAGE_SIZE, filteredUsers.length)}
                      {" of "}{filteredUsers.length}
                    </span>

                    <div className="pagination-actions">
                      <button
                        className="page-btn"
                        disabled={currentPage <= 1}
                        onClick={() => setPage((p) => Math.max(1, p - 1))}
                        aria-label="Previous page"
                      >
                        <ChevronLeft size={17} />
                      </button>

                      <span className="page-number">
                        {currentPage} / {Math.max(totalPages, 1)}
                      </span>

                      <button
                        className="page-btn"
                        disabled={currentPage >= totalPages}
                        onClick={() =>
                          setPage((p) => Math.min(totalPages, p + 1))
                        }
                        aria-label="Next page"
                      >
                        <ChevronRight size={17} />
                      </button>
                    </div>
                  </div>
                </>
              )}
            </section>
          </>
        ) : (
          <section className="panel placeholder-panel">
            {active === "Orders" ? <ShoppingBag size={35} /> :
              active === "Products" ? <Package size={35} /> :
              active === "Analytics" ? <IndianRupee size={35} /> :
              <Users size={35} />}
            <h2>{active}</h2>
            <p>
              This section is a UI placeholder. Connect the relevant API
              to implement real {active.toLowerCase()} management.
            </p>
            <button
              className="refresh-btn"
              onClick={() => setActive("Dashboard")}
            >
              Back to Dashboard
            </button>
          </section>
        )}

        <footer className="footer">
          © 2026 AdminPro. React Admin Dashboard.
        </footer>
      </main>
    </div>
  );
}
